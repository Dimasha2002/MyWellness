<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass shadow -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners 
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    
    <!-- Glass container -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F8F9FA"
                android:centerColor="#E9ECEF"
                android:endColor="#DEE2E6"
                android:angle="45" />
            <corners 
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp" />
            <stroke android:width="1dp" android:color="#ADB5BD" />
        </shape>
    </item>
    
    <!-- Water inside -->
    <item android:top="8dp" android:left="5dp" android:right="7dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#03A9F4"
                android:centerColor="#29B6F6"
                android:endColor="#4FC3F7"
                android:angle="90" />
            <corners 
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="22dp" />
        </shape>
    </item>
    
    <!-- Water surface highlight -->
    <item android:top="8dp" android:left="8dp" android:right="10dp" android:bottom="45dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#80E1F5FE"
                android:endColor="#4081D4E1"
                android:angle="90" />
        </shape>
    </item>
    
    <!-- Bubbles -->
    <item android:top="18dp" android:left="15dp" android:right="35dp" android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#B3E5FC" />
        </shape>
    </item>
    
    <item android:top="28dp" android:left="30dp" android:right="20dp" android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#B3E5FC" />
        </shape>
    </item>
    
    <item android:top="35dp" android:left="20dp" android:right="30dp" android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="#81D4FA" />
        </shape>
    </item>
    
    <!-- Glass highlight -->
    <item android:top="6dp" android:left="8dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="#60FFFFFF" />
        </shape>
    </item>
</layer-list>