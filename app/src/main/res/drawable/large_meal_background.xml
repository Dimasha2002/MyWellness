<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main gradient background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFE0B2"
                android:centerColor="#FFCC02" 
                android:endColor="#FF8F00"
                android:type="radial"
                android:gradientRadius="70dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    
    <!-- Inner glow effect -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#30FFFFFF"
                android:centerColor="#60FFFFFF"
                android:endColor="#10FFFFFF"
                android:type="radial"
                android:gradientRadius="40dp" />
        </shape>
    </item>
    
    <!-- Subtle shadow inside -->
    <item android:top="35dp" android:left="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#20000000" />
        </shape>
    </item>
</layer-list>