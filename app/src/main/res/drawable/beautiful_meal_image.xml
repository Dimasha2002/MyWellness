<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plate shadow -->
    <item android:top="3dp" android:left="3dp">
        <shape android:shape="oval">
            <solid android:color="#20000000" />
        </shape>
    </item>
    
    <!-- Main plate -->
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F8F9FA"
                android:endColor="#E9ECEF"
                android:type="radial"
                android:gradientRadius="40dp" />
            <stroke android:width="1dp" android:color="#DEE2E6" />
        </shape>
    </item>
    
    <!-- Main dish -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF6B35"
                android:centerColor="#F7931E"
                android:endColor="#FFB74D"
                android:type="radial"
                android:gradientRadius="25dp" />
        </shape>
    </item>
    
    <!-- Vegetables -->
    <item android:top="16dp" android:left="16dp" android:right="32dp" android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#66BB6A" />
        </shape>
    </item>
    
    <item android:top="32dp" android:left="32dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#EF5350" />
        </shape>
    </item>
    
    <item android:top="20dp" android:left="28dp" android:right="20dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#FFCA28" />
        </shape>
    </item>
    
    <!-- Highlight on plate -->
    <item android:top="8dp" android:left="12dp" android:right="35dp" android:bottom="35dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>