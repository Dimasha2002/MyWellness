<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plate shadow -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="oval">
            <solid android:color="#20000000" />
        </shape>
    </item>
    
    <!-- Main plate -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#E8F4FD" />
            <stroke android:width="2dp" android:color="#B3D9F2" />
        </shape>
    </item>
    
    <!-- Rice/base -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#F5F5DC" />
        </shape>
    </item>
    
    <!-- Fried egg -->
    <item android:top="16dp" android:left="20dp" android:right="20dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#FFFAF0" />
        </shape>
    </item>
    
    <!-- Egg yolk -->
    <item android:top="20dp" android:left="24dp" android:right="24dp" android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Green vegetables -->
    <item android:top="18dp" android:left="14dp" android:right="30dp" android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#90EE90" />
        </shape>
    </item>
    
    <!-- Red vegetables -->
    <item android:top="24dp" android:left="30dp" android:right="16dp" android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#FF6347" />
        </shape>
    </item>
    
    <!-- Steam lines -->
    <item android:top="6dp" android:left="16dp" android:right="40dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE4B5" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    
    <item android:top="6dp" android:left="22dp" android:right="34dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE4B5" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>